# Supabase → Project Settings → API keys
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Printed by supabase/migrations/0002_single_user.sql (or: select token from private.app_token;)
EXPO_PUBLIC_APP_TOKEN=
# Free key from https://fdc.nal.usda.gov/api-key-signup (DEMO_KEY works but is heavily rate-limited)
EXPO_PUBLIC_USDA_API_KEY=DEMO_KEY
# Hevy API key (hevy.com → Settings → Developer, requires Hevy Pro). Optional, for "Sync Hevy" in Settings.
EXPO_PUBLIC_HEVY_API_KEY=
